{
  "$description": "on-brand monet-parasol preset — HAND-AUTHORED vision-judge mood anchor (brand-fidelity benchmark Step 4, issue #33). NOT extracted from a live site; not a general-purpose UI preset. Palette grounded in Monet's \"Woman with a Parasol\" (1875): bright sky blue, sunlit white/cream, fresh meadow green, warm figure accents -- airy, high-key, cool-leaning. Excluded from the fidelity rollup; used only as a mood-anchor image pairing for the vision judge. All declared text/bg pairs pass WCAG 2 AA.",
  "$extensions": {
    "onbrand": {
      "schemaVersion": 1
    }
  },
  "color": {
    "$type": "color",
    "primitive": {
      "brand": {
        "$description": "Brand ramp, 12 steps light-to-dark (Radix-style scale).",
        "1": { "$value": "#fbfdfe" },
        "2": { "$value": "#f5f9fd" },
        "3": { "$value": "#e9f3fa" },
        "4": { "$value": "#d8e9f6" },
        "5": { "$value": "#c2ddf1" },
        "6": { "$value": "#a5ccea" },
        "7": { "$value": "#7eb6e1" },
        "8": { "$value": "#4e9bd5" },
        "9": { "$value": "#2b7bb8" },
        "10": { "$value": "#276fa6" },
        "11": { "$value": "#226090" },
        "12": { "$value": "#143853" }
      },
      "neutral": {
        "$description": "Cool-gray neutral ramp, 12 steps light-to-dark.",
        "1": { "$value": "#fcfcfd" },
        "2": { "$value": "#f8f9fa" },
        "3": { "$value": "#f0f2f4" },
        "4": { "$value": "#e8ebed" },
        "5": { "$value": "#dde1e5" },
        "6": { "$value": "#cfd6db" },
        "7": { "$value": "#bac4cb" },
        "8": { "$value": "#9aa8b2" },
        "9": { "$value": "#7a8c9a" },
        "10": { "$value": "#687b8a" },
        "11": { "$value": "#556571" },
        "12": { "$value": "#20262b" }
      }
    },
    "semantic": {
      "bg": { "$value": "#fcfcfd" },
      "surface": { "$value": "#ffffff" },
      "text": { "$value": "#20262b" },
      "text-muted": { "$value": "#556571" },
      "border": { "$value": "#dde1e5" },
      "accent": { "$value": "#2b7bb8" },
      "code-bg": { "$value": "#f0f2f4" },
      "shadow-color": { "$value": "#20262b29" }
    },
    "status": {
      "success": {
        "fg": { "$value": "#1b6a35" },
        "bg": { "$value": "#dff6e7" }
      },
      "warning": {
        "fg": { "$value": "#7b510a" },
        "bg": { "$value": "#faebc6" }
      },
      "danger": {
        "fg": { "$value": "#9d3525" },
        "bg": { "$value": "#f9e0dc" }
      },
      "info": {
        "fg": { "$value": "#1d5987" },
        "bg": { "$value": "#dcedf9" }
      }
    },
    "chart": {
      "categorical": {
        "$description": "8 distinguishable series colors for light backgrounds.",
        "1": { "$value": "#3689c9" },
        "2": { "$value": "#409651" },
        "3": { "$value": "#d7a542" },
        "4": { "$value": "#9272b6" },
        "5": { "$value": "#da6272" },
        "6": { "$value": "#358d8a" },
        "7": { "$value": "#b38719" },
        "8": { "$value": "#8ba63f" }
      },
      "sequential": {
        "$description": "7-step light-to-dark sequential ramp derived from the brand hue.",
        "1": { "$value": "#e9f3fa" },
        "2": { "$value": "#c2ddf1" },
        "3": { "$value": "#96c3e6" },
        "4": { "$value": "#65a8db" },
        "5": { "$value": "#318bcf" },
        "6": { "$value": "#276fa6" },
        "7": { "$value": "#143853" }
      },
      "chrome": {
        "grid": { "$value": "#e8ebed" },
        "axis": { "$value": "#9aa8b2" },
        "label": { "$value": "#556571" },
        "tooltip-bg": { "$value": "#ffffff" }
      }
    },
    "diagram": {
      "canvas": { "$value": "#f5f9fd" },
      "node-fill": { "$value": "#ffffff" },
      "node-stroke": { "$value": "#7eb6e1" },
      "link": { "$value": "#7a8c9a" },
      "spine-accent": { "$value": "#2b7bb8" },
      "label": { "$value": "#20262b" },
      "chip-highlight": { "$value": "#e9f3fa" },
      "warning": { "$value": "#b45309" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["Inter", "Segoe UI", "system-ui", "sans-serif"] },
    "heading": { "$value": ["Manrope", "Inter", "Segoe UI", "system-ui", "sans-serif"] },
    "mono": { "$value": ["JetBrains Mono", "Cascadia Code", "Consolas", "monospace"] }
  },
  "type": {
    "size": {
      "$type": "dimension",
      "base": { "$value": "1rem" }
    },
    "scale": {
      "$type": "dimension",
      "$description": "Fluid type scale, Utopia method (1rem@360px -> 1.125rem@1240px base, 1.2/1.25 ratio).",
      "step--1": { "$value": "clamp(0.8333rem, 0.8101rem + 0.1031vw, 0.9rem)" },
      "step-0": { "$value": "clamp(1rem, 0.9489rem + 0.2273vw, 1.125rem)" },
      "step-1": { "$value": "clamp(1.2rem, 1.131rem + 0.3068vw, 1.4063rem)" },
      "step-2": { "$value": "clamp(1.44rem, 1.3468rem + 0.4141vw, 1.7578rem)" },
      "step-3": { "$value": "clamp(1.728rem, 1.6022rem + 0.5591vw, 2.1973rem)" },
      "step-4": { "$value": "clamp(2.0736rem, 1.9037rem + 0.7547vw, 2.7466rem)" },
      "step-5": { "$value": "clamp(2.4883rem, 2.2593rem + 1.0182vw, 3.4332rem)" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "base": { "$value": 1.55 },
      "loose": { "$value": 1.7 }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px grid: 4, 8, 12, 16, 24, 32, 40, 48, 64, 96 px.",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.5rem" },
    "6": { "$value": "2rem" },
    "7": { "$value": "2.5rem" },
    "8": { "$value": "3rem" },
    "9": { "$value": "4rem" },
    "10": { "$value": "6rem" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "pill": { "$value": "999px" }
  },
  "shadow": {
    "$type": "shadow",
    "elevation-1": {
      "$value": {
        "color": "#1f242c14",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "elevation-2": {
      "$value": {
        "color": "#1f242c1f",
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "8px",
        "spread": "-1px"
      }
    },
    "elevation-3": {
      "$value": {
        "color": "#1f242c29",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "-4px"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "400ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "$description": "Reduced-motion preferences are always respected by consumers.",
      "standard": { "$value": [0.4, 0, 0.2, 1] },
      "decelerate": { "$value": [0, 0, 0.2, 1] },
      "accelerate": { "$value": [0.4, 0, 1, 1] }
    }
  }
}
