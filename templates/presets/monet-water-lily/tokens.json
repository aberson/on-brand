{
  "$description": "on-brand monet-water-lily preset — HAND-AUTHORED vision-judge mood anchor (brand-fidelity benchmark Step 4, issue #33). NOT extracted from a live site; not a general-purpose UI preset. Palette grounded in Monet's \"Water Lilies\" series: deep greens, pond blues, soft pink/lavender lily accents -- muted, cool-green, contemplative. Excluded from the fidelity rollup; used only as a mood-anchor image pairing for the vision judge. All declared text/bg pairs pass WCAG 2 AA.",
  "$extensions": {
    "onbrand": {
      "schemaVersion": 1
    }
  },
  "color": {
    "$type": "color",
    "primitive": {
      "brand": {
        "$description": "Brand ramp, 12 steps light-to-dark (Radix-style scale).",
        "1": { "$value": "#fbfefd" },
        "2": { "$value": "#f6fbfa" },
        "3": { "$value": "#ebf8f5" },
        "4": { "$value": "#dcf2ee" },
        "5": { "$value": "#c9eae4" },
        "6": { "$value": "#aee0d6" },
        "7": { "$value": "#8cd3c5" },
        "8": { "$value": "#60c3af" },
        "9": { "$value": "#3ea590" },
        "10": { "$value": "#389582" },
        "11": { "$value": "#318171" },
        "12": { "$value": "#1c4b41" }
      },
      "neutral": {
        "$description": "Cool-gray neutral ramp, 12 steps light-to-dark.",
        "1": { "$value": "#fcfdfc" },
        "2": { "$value": "#f8faf9" },
        "3": { "$value": "#f0f4f2" },
        "4": { "$value": "#e8edeb" },
        "5": { "$value": "#dde5e1" },
        "6": { "$value": "#d0dad5" },
        "7": { "$value": "#bbcac3" },
        "8": { "$value": "#9bb1a6" },
        "9": { "$value": "#7c988a" },
        "10": { "$value": "#6b8879" },
        "11": { "$value": "#576f63" },
        "12": { "$value": "#212a25" }
      }
    },
    "semantic": {
      "bg": { "$value": "#fcfdfc" },
      "surface": { "$value": "#ffffff" },
      "text": { "$value": "#212a25" },
      "text-muted": { "$value": "#576f63" },
      "border": { "$value": "#dde5e1" },
      "accent": { "$value": "#3ea590" },
      "code-bg": { "$value": "#f0f4f2" },
      "shadow-color": { "$value": "#212a2529" }
    },
    "status": {
      "success": {
        "fg": { "$value": "#1e6742" },
        "bg": { "$value": "#e1f4eb" }
      },
      "warning": {
        "fg": { "$value": "#76540f" },
        "bg": { "$value": "#f9eac7" }
      },
      "danger": {
        "fg": { "$value": "#96362c" },
        "bg": { "$value": "#f7e1de" }
      },
      "info": {
        "fg": { "$value": "#216283" },
        "bg": { "$value": "#ddeff8" }
      }
    },
    "chart": {
      "categorical": {
        "$description": "8 distinguishable series colors for light backgrounds.",
        "1": { "$value": "#2d7668" },
        "2": { "$value": "#3f84a6" },
        "3": { "$value": "#d69ab3" },
        "4": { "$value": "#ac97c4" },
        "5": { "$value": "#75a385" },
        "6": { "$value": "#36777d" },
        "7": { "$value": "#77804d" },
        "8": { "$value": "#b4747e" }
      },
      "sequential": {
        "$description": "7-step light-to-dark sequential ramp derived from the brand hue.",
        "1": { "$value": "#ebf8f5" },
        "2": { "$value": "#c9eae4" },
        "3": { "$value": "#a1dbd0" },
        "4": { "$value": "#75cbba" },
        "5": { "$value": "#47b9a2" },
        "6": { "$value": "#389582" },
        "7": { "$value": "#1c4b41" }
      },
      "chrome": {
        "grid": { "$value": "#e8edeb" },
        "axis": { "$value": "#9bb1a6" },
        "label": { "$value": "#576f63" },
        "tooltip-bg": { "$value": "#ffffff" }
      }
    },
    "diagram": {
      "canvas": { "$value": "#f6fbfa" },
      "node-fill": { "$value": "#ffffff" },
      "node-stroke": { "$value": "#8cd3c5" },
      "link": { "$value": "#7c988a" },
      "spine-accent": { "$value": "#3ea590" },
      "label": { "$value": "#212a25" },
      "chip-highlight": { "$value": "#ebf8f5" },
      "warning": { "$value": "#a3701f" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["Inter", "Segoe UI", "system-ui", "sans-serif"] },
    "heading": { "$value": ["Manrope", "Inter", "Segoe UI", "system-ui", "sans-serif"] },
    "mono": { "$value": ["JetBrains Mono", "Cascadia Code", "Consolas", "monospace"] }
  },
  "type": {
    "size": {
      "$type": "dimension",
      "base": { "$value": "1rem" }
    },
    "scale": {
      "$type": "dimension",
      "$description": "Fluid type scale, Utopia method (1rem@360px -> 1.125rem@1240px base, 1.2/1.25 ratio).",
      "step--1": { "$value": "clamp(0.8333rem, 0.8101rem + 0.1031vw, 0.9rem)" },
      "step-0": { "$value": "clamp(1rem, 0.9489rem + 0.2273vw, 1.125rem)" },
      "step-1": { "$value": "clamp(1.2rem, 1.131rem + 0.3068vw, 1.4063rem)" },
      "step-2": { "$value": "clamp(1.44rem, 1.3468rem + 0.4141vw, 1.7578rem)" },
      "step-3": { "$value": "clamp(1.728rem, 1.6022rem + 0.5591vw, 2.1973rem)" },
      "step-4": { "$value": "clamp(2.0736rem, 1.9037rem + 0.7547vw, 2.7466rem)" },
      "step-5": { "$value": "clamp(2.4883rem, 2.2593rem + 1.0182vw, 3.4332rem)" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "base": { "$value": 1.55 },
      "loose": { "$value": 1.7 }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px grid: 4, 8, 12, 16, 24, 32, 40, 48, 64, 96 px.",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.5rem" },
    "6": { "$value": "2rem" },
    "7": { "$value": "2.5rem" },
    "8": { "$value": "3rem" },
    "9": { "$value": "4rem" },
    "10": { "$value": "6rem" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "pill": { "$value": "999px" }
  },
  "shadow": {
    "$type": "shadow",
    "elevation-1": {
      "$value": {
        "color": "#1f242c14",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "elevation-2": {
      "$value": {
        "color": "#1f242c1f",
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "8px",
        "spread": "-1px"
      }
    },
    "elevation-3": {
      "$value": {
        "color": "#1f242c29",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "-4px"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "400ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "$description": "Reduced-motion preferences are always respected by consumers.",
      "standard": { "$value": [0.4, 0, 0.2, 1] },
      "decelerate": { "$value": [0, 0, 0.2, 1] },
      "accelerate": { "$value": [0.4, 0, 1, 1] }
    }
  }
}
