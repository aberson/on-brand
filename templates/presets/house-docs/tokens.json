{
  "$description": "on-brand house-docs preset — reusable light-theme source of truth calibrated from the historical 2026-07-17 skill-mesh and aberson-profile diagram inventory. This local artifact does not assert either downstream project's current adoption or repository state. color.diagram is LIFTED from the recorded hand-baked SVG palette; the non-diagram categories mirror the default preset (WCAG 2 AA on every declared text/bg pair).",
  "$extensions": {
    "onbrand": {
      "schemaVersion": 1
    }
  },
  "color": {
    "$type": "color",
    "primitive": {
      "brand": {
        "$description": "Brand ramp, 12 steps light-to-dark (Radix-style scale).",
        "1": { "$value": "#fbfcfe" },
        "2": { "$value": "#f5f7fc" },
        "3": { "$value": "#e9eefa" },
        "4": { "$value": "#d9e2f5" },
        "5": { "$value": "#c4d3ef" },
        "6": { "$value": "#a9bfe6" },
        "7": { "$value": "#86a5d9" },
        "8": { "$value": "#5c84c7" },
        "9": { "$value": "#3b63a8" },
        "10": { "$value": "#33569a" },
        "11": { "$value": "#2c4a86" },
        "12": { "$value": "#1a2b4d" }
      },
      "neutral": {
        "$description": "Cool-gray neutral ramp, 12 steps light-to-dark.",
        "1": { "$value": "#fcfcfd" },
        "2": { "$value": "#f8f9fa" },
        "3": { "$value": "#f0f1f4" },
        "4": { "$value": "#e7e9ee" },
        "5": { "$value": "#dcdfe6" },
        "6": { "$value": "#ced3dc" },
        "7": { "$value": "#b9c0cc" },
        "8": { "$value": "#99a2b3" },
        "9": { "$value": "#7c8698" },
        "10": { "$value": "#6b7587" },
        "11": { "$value": "#566070" },
        "12": { "$value": "#1f242c" }
      }
    },
    "semantic": {
      "bg": { "$value": "#fcfcfd" },
      "surface": { "$value": "#ffffff" },
      "text": { "$value": "#1f242c" },
      "text-muted": { "$value": "#566070" },
      "border": { "$value": "#dcdfe6" },
      "accent": { "$value": "#3b63a8" },
      "code-bg": { "$value": "#f0f1f4" },
      "shadow-color": { "$value": "#1f242c29" }
    },
    "status": {
      "success": {
        "fg": { "$value": "#166534" },
        "bg": { "$value": "#dcfce7" }
      },
      "warning": {
        "fg": { "$value": "#854d0e" },
        "bg": { "$value": "#fef3c7" }
      },
      "danger": {
        "fg": { "$value": "#991b1b" },
        "bg": { "$value": "#fee2e2" }
      },
      "info": {
        "fg": { "$value": "#1e40af" },
        "bg": { "$value": "#dbeafe" }
      }
    },
    "chart": {
      "categorical": {
        "$description": "8 distinguishable series colors for light backgrounds.",
        "1": { "$value": "#3b63a8" },
        "2": { "$value": "#c8571f" },
        "3": { "$value": "#2e8b57" },
        "4": { "$value": "#c03434" },
        "5": { "$value": "#7d5ba6" },
        "6": { "$value": "#1f8a8a" },
        "7": { "$value": "#b8860b" },
        "8": { "$value": "#c2578f" }
      },
      "sequential": {
        "$description": "7-step light-to-dark sequential ramp derived from the brand hue.",
        "1": { "$value": "#e9eefa" },
        "2": { "$value": "#c4d3ef" },
        "3": { "$value": "#9db9e6" },
        "4": { "$value": "#6f93cf" },
        "5": { "$value": "#4a6fb0" },
        "6": { "$value": "#33569a" },
        "7": { "$value": "#1a2b4d" }
      },
      "chrome": {
        "grid": { "$value": "#e7e9ee" },
        "axis": { "$value": "#99a2b3" },
        "label": { "$value": "#566070" },
        "tooltip-bg": { "$value": "#ffffff" }
      }
    },
    "diagram": {
      "$description": "Lifted EXHAUSTIVELY from the light-variant source-art inventory recorded for the 2026-07-17 skill-mesh and aberson-profile pilot. Every distinct recorded color used for a diagram role has a key here. Role -> SVG class: canvas=.bg fill; canvas-border=.bg stroke (softer frame, also the dashed section-divider line) — deliberately softer than node-stroke; node-fill=.node/.rail/.innode rect fill; node-stroke=.node rect stroke; link=.lnk/.fan stroke + arrow marker; spine-accent=.spine/.fork/.pn/.rail-name/.gw-cmd + chip stroke + spine arrow; label=.lbl/.ps/.cap/.rail-dest/.title/.chip-lbl muted text; title-strong=.hub-t (near-black hub title); text-muted=.in-t (mid-gray node text); chip-highlight=.chip rect fill; warning=.rail-sub (recorded annotation-emphasis subtext — the canonical §4 color.diagram key name is kept, though the source usage is emphasis, not an alert).",
      "canvas": { "$value": "#ffffff" },
      "canvas-border": { "$value": "#d4dbe8" },
      "node-fill": { "$value": "#ffffff" },
      "node-stroke": { "$value": "#c0c9da" },
      "link": { "$value": "#c0c9da" },
      "spine-accent": { "$value": "#3355e0" },
      "label": { "$value": "#6e778c" },
      "title-strong": { "$value": "#171b24" },
      "text-muted": { "$value": "#454e62" },
      "chip-highlight": { "$value": "#e4e9fb" },
      "warning": { "$value": "#b6771f" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["Inter", "Segoe UI", "system-ui", "sans-serif"] },
    "heading": { "$value": ["Manrope", "Inter", "Segoe UI", "system-ui", "sans-serif"] },
    "mono": { "$value": ["JetBrains Mono", "Cascadia Code", "Consolas", "monospace"] }
  },
  "type": {
    "size": {
      "$type": "dimension",
      "base": { "$value": "1rem" }
    },
    "scale": {
      "$type": "dimension",
      "$description": "Fluid type scale, Utopia method (1rem@360px -> 1.125rem@1240px base, 1.2/1.25 ratio).",
      "step--1": { "$value": "clamp(0.8333rem, 0.8101rem + 0.1031vw, 0.9rem)" },
      "step-0": { "$value": "clamp(1rem, 0.9489rem + 0.2273vw, 1.125rem)" },
      "step-1": { "$value": "clamp(1.2rem, 1.131rem + 0.3068vw, 1.4063rem)" },
      "step-2": { "$value": "clamp(1.44rem, 1.3468rem + 0.4141vw, 1.7578rem)" },
      "step-3": { "$value": "clamp(1.728rem, 1.6022rem + 0.5591vw, 2.1973rem)" },
      "step-4": { "$value": "clamp(2.0736rem, 1.9037rem + 0.7547vw, 2.7466rem)" },
      "step-5": { "$value": "clamp(2.4883rem, 2.2593rem + 1.0182vw, 3.4332rem)" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "base": { "$value": 1.55 },
      "loose": { "$value": 1.7 }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px grid: 4, 8, 12, 16, 24, 32, 40, 48, 64, 96 px.",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.5rem" },
    "6": { "$value": "2rem" },
    "7": { "$value": "2.5rem" },
    "8": { "$value": "3rem" },
    "9": { "$value": "4rem" },
    "10": { "$value": "6rem" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "pill": { "$value": "999px" }
  },
  "shadow": {
    "$type": "shadow",
    "elevation-1": {
      "$value": {
        "color": "#1f242c14",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "elevation-2": {
      "$value": {
        "color": "#1f242c1f",
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "8px",
        "spread": "-1px"
      }
    },
    "elevation-3": {
      "$value": {
        "color": "#1f242c29",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "-4px"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "400ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "$description": "Reduced-motion preferences are always respected by consumers.",
      "standard": { "$value": [0.4, 0, 0.2, 1] },
      "decelerate": { "$value": [0, 0, 0.2, 1] },
      "accelerate": { "$value": [0.4, 0, 1, 1] }
    }
  }
}
