{
  "$description": "on-brand monet-mismatch-anchor preset — HAND-AUTHORED NEGATIVE vision-judge anchor (brand-fidelity benchmark Step 4, issue #33). NOT extracted from a live site; not a general-purpose UI preset; NEVER meant to look \"correct\". Deliberately mismatched: it states \"Water Lilies\" as its reference painting but carries a harsh neon/cyber palette (electric magenta, acid green, electric cyan, radioactive yellow) that shares no hue family with the real Water Lilies series (muted cool greens/blues/pinks). Purpose: force the vision judge in Step 9 to FAIL this pairing while PASSing the real monet-water-lily preset against the same reference -- a discrimination calibration anchor, not a style to emulate. Full rationale + measured color distance: PROVENANCE.md in this directory. Excluded from the fidelity rollup. All declared text/bg pairs still pass WCAG 2 AA (a judge must fail it on AESTHETIC grounds, not by exploiting an accessibility bug).",
  "$extensions": {
    "onbrand": {
      "schemaVersion": 1
    }
  },
  "color": {
    "$type": "color",
    "primitive": {
      "brand": {
        "$description": "Brand ramp, 12 steps light-to-dark (Radix-style scale).",
        "1": { "$value": "#fffafe" },
        "2": { "$value": "#fff3fc" },
        "3": { "$value": "#fee5f9" },
        "4": { "$value": "#fed0f5" },
        "5": { "$value": "#fdb6ef" },
        "6": { "$value": "#fc93e7" },
        "7": { "$value": "#fb64dd" },
        "8": { "$value": "#fa2ad0" },
        "9": { "$value": "#dd06b2" },
        "10": { "$value": "#c805a1" },
        "11": { "$value": "#ae048c" },
        "12": { "$value": "#640351" }
      },
      "neutral": {
        "$description": "Cool-gray neutral ramp, 12 steps light-to-dark.",
        "1": { "$value": "#fcfcfc" },
        "2": { "$value": "#f9f9f9" },
        "3": { "$value": "#f2f2f2" },
        "4": { "$value": "#ebebeb" },
        "5": { "$value": "#e1e1e1" },
        "6": { "$value": "#d5d5d5" },
        "7": { "$value": "#c3c3c3" },
        "8": { "$value": "#a6a6a6" },
        "9": { "$value": "#8a8a8a" },
        "10": { "$value": "#797979" },
        "11": { "$value": "#636363" },
        "12": { "$value": "#252525" }
      }
    },
    "semantic": {
      "bg": { "$value": "#fcfcfc" },
      "surface": { "$value": "#ffffff" },
      "text": { "$value": "#252525" },
      "text-muted": { "$value": "#636363" },
      "border": { "$value": "#e1e1e1" },
      "accent": { "$value": "#dd06b2" },
      "code-bg": { "$value": "#f2f2f2" },
      "shadow-color": { "$value": "#25252529" }
    },
    "status": {
      "success": {
        "fg": { "$value": "#167703" },
        "bg": { "$value": "#cefcc5" }
      },
      "warning": {
        "fg": { "$value": "#705d00" },
        "bg": { "$value": "#fff2b3" }
      },
      "danger": {
        "fg": { "$value": "#a90425" },
        "bg": { "$value": "#fdd8e0" }
      },
      "info": {
        "fg": { "$value": "#036072" },
        "bg": { "$value": "#cff5fc" }
      }
    },
    "chart": {
      "categorical": {
        "$description": "8 distinguishable series colors for light backgrounds.",
        "1": { "$value": "#f910ca" },
        "2": { "$value": "#25c705" },
        "3": { "$value": "#06bbe0" },
        "4": { "$value": "#ffd400" },
        "5": { "$value": "#f20d0d" },
        "6": { "$value": "#8c25f4" },
        "7": { "$value": "#0bcb6b" },
        "8": { "$value": "#f4258c" }
      },
      "sequential": {
        "$description": "7-step light-to-dark sequential ramp derived from the brand hue.",
        "1": { "$value": "#fee5f9" },
        "2": { "$value": "#fdb6ef" },
        "3": { "$value": "#fc80e3" },
        "4": { "$value": "#fa46d6" },
        "5": { "$value": "#f907c8" },
        "6": { "$value": "#c805a1" },
        "7": { "$value": "#640351" }
      },
      "chrome": {
        "grid": { "$value": "#ebebeb" },
        "axis": { "$value": "#a6a6a6" },
        "label": { "$value": "#636363" },
        "tooltip-bg": { "$value": "#ffffff" }
      }
    },
    "diagram": {
      "canvas": { "$value": "#fff3fc" },
      "node-fill": { "$value": "#ffffff" },
      "node-stroke": { "$value": "#fb64dd" },
      "link": { "$value": "#8a8a8a" },
      "spine-accent": { "$value": "#dd06b2" },
      "label": { "$value": "#252525" },
      "chip-highlight": { "$value": "#fee5f9" },
      "warning": { "$value": "#ff2fb0" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["Inter", "Segoe UI", "system-ui", "sans-serif"] },
    "heading": { "$value": ["Manrope", "Inter", "Segoe UI", "system-ui", "sans-serif"] },
    "mono": { "$value": ["JetBrains Mono", "Cascadia Code", "Consolas", "monospace"] }
  },
  "type": {
    "size": {
      "$type": "dimension",
      "base": { "$value": "1rem" }
    },
    "scale": {
      "$type": "dimension",
      "$description": "Fluid type scale, Utopia method (1rem@360px -> 1.125rem@1240px base, 1.2/1.25 ratio).",
      "step--1": { "$value": "clamp(0.8333rem, 0.8101rem + 0.1031vw, 0.9rem)" },
      "step-0": { "$value": "clamp(1rem, 0.9489rem + 0.2273vw, 1.125rem)" },
      "step-1": { "$value": "clamp(1.2rem, 1.131rem + 0.3068vw, 1.4063rem)" },
      "step-2": { "$value": "clamp(1.44rem, 1.3468rem + 0.4141vw, 1.7578rem)" },
      "step-3": { "$value": "clamp(1.728rem, 1.6022rem + 0.5591vw, 2.1973rem)" },
      "step-4": { "$value": "clamp(2.0736rem, 1.9037rem + 0.7547vw, 2.7466rem)" },
      "step-5": { "$value": "clamp(2.4883rem, 2.2593rem + 1.0182vw, 3.4332rem)" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "base": { "$value": 1.55 },
      "loose": { "$value": 1.7 }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px grid: 4, 8, 12, 16, 24, 32, 40, 48, 64, 96 px.",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.5rem" },
    "6": { "$value": "2rem" },
    "7": { "$value": "2.5rem" },
    "8": { "$value": "3rem" },
    "9": { "$value": "4rem" },
    "10": { "$value": "6rem" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "pill": { "$value": "999px" }
  },
  "shadow": {
    "$type": "shadow",
    "elevation-1": {
      "$value": {
        "color": "#1f242c14",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "elevation-2": {
      "$value": {
        "color": "#1f242c1f",
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "8px",
        "spread": "-1px"
      }
    },
    "elevation-3": {
      "$value": {
        "color": "#1f242c29",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "-4px"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "400ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "$description": "Reduced-motion preferences are always respected by consumers.",
      "standard": { "$value": [0.4, 0, 0.2, 1] },
      "decelerate": { "$value": [0, 0, 0.2, 1] },
      "accelerate": { "$value": [0.4, 0, 1, 1] }
    }
  }
}
