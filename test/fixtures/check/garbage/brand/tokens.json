{
  "$description": "CALIBRATION ANCHOR (measurement-validity): grey-on-grey. Schema-valid so check reaches the contrast gate, but EVERY declared fg/bg pairing fails WCAG 2 AA. onbrand check MUST fail this, naming the token paths + both colors + the ratio. A gate that cannot fail garbage cannot gate.",
  "$extensions": {
    "onbrand": {
      "schemaVersion": 1
    }
  },
  "color": {
    "$type": "color",
    "semantic": {
      "bg": { "$value": "#8a8a8a" },
      "surface": { "$value": "#909090" },
      "text": { "$value": "#7c7c7c" },
      "text-muted": { "$value": "#828282" },
      "border": { "$value": "#999999" },
      "accent": { "$value": "#6f6f6f" }
    },
    "status": {
      "success": { "fg": { "$value": "#808080" }, "bg": { "$value": "#888888" } },
      "warning": { "fg": { "$value": "#818181" }, "bg": { "$value": "#898989" } },
      "danger": { "fg": { "$value": "#7f7f7f" }, "bg": { "$value": "#878787" } },
      "info": { "fg": { "$value": "#838383" }, "bg": { "$value": "#8b8b8b" } }
    }
  }
}
