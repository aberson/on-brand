    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "120ms"
      },
      "base": {
        "$value": "200ms"
      },
      "slow": {
        "$value": "400ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "$description": "Reduced-motion preferences are always respected by consumers.",
      "standard": {
        "$value": [
          0.4,
          0,
          0.2,
          1
        ]
      },
      "decelerate": {
        "$value": [
          0,
          0,
          0.2,
          1
        ]
      },
      "accelerate": {
        "$value": [
          0.4,
          0,
          1,
          1
        ]
      }
    }
  }
