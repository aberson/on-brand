    "$type": "shadow",
    "elevation-1": {
      "$value": {
        "color": "#1f242c14",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "elevation-2": {
      "$value": {
        "color": "#1f242c1f",
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "8px",
        "spread": "-1px"
      }
    },
    "elevation-3": {
      "$value": {
        "color": "#1f242c29",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "-4px"
      }
    }
  },
