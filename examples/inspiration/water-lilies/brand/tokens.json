  "type": {
    "size": {
      "$type": "dimension",
      "base": {
        "$value": "1rem"
      }
    },
    "scale": {
      "$type": "dimension",
      "$description": "Fluid type scale, Utopia method (1rem@360px -> 1.125rem@1240px base, 1.2/1.25 ratio).",
      "step--1": {
        "$value": "clamp(0.8333rem, 0.8101rem + 0.1031vw, 0.9rem)"
      },
      "step-0": {
        "$value": "clamp(1rem, 0.9489rem + 0.2273vw, 1.125rem)"
      },
      "step-1": {
        "$value": "clamp(1.2rem, 1.131rem + 0.3068vw, 1.4063rem)"
      },
      "step-2": {
        "$value": "clamp(1.44rem, 1.3468rem + 0.4141vw, 1.7578rem)"
      },
      "step-3": {
        "$value": "clamp(1.728rem, 1.6022rem + 0.5591vw, 2.1973rem)"
      },
      "step-4": {
        "$value": "clamp(2.0736rem, 1.9037rem + 0.7547vw, 2.7466rem)"
      },
      "step-5": {
        "$value": "clamp(2.4883rem, 2.2593rem + 1.0182vw, 3.4332rem)"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
